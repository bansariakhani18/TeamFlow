              "});",
              "pm.test('Error message explains short title', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Project Tasks with Filter (200 OK)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks?status=todo&priority=high",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "tasks"],
          "query": [
            { "key": "status", "value": "todo" },
            { "key": "priority", "value": "high" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns list of tasks and pagination', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(Array.isArray(jsonData.data)).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
