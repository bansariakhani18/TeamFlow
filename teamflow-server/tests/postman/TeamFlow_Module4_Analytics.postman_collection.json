          "path": ["api", "dashboard", "me"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns personal cross-project summary', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('totalAssigned');",
              "    pm.expect(jsonData.data).to.have.property('overdueTasks');",
              "    pm.expect(jsonData.data).to.have.property('dueSoonTasks');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Analytics - Non-Member Access (403 Forbidden - TC-DSH-09)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{nonMemberToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/analytics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "analytics"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
