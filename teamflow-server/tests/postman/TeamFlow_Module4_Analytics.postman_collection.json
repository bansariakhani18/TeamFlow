{
  "info": {
    "name": "TeamFlow - Module 4: Dashboard, Analytics & Notifications",
    "_postman_id": "a4d7f98e-m4-analytics-dashboard-v1",
    "description": "Postman test suite for TeamFlow Module 4 (Kriti Patel - 202512018). Tests project analytics aggregation, completion rates, workload distribution, CSV export, task reminders via Resend API, notification audit logs, and personal dashboard.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get Project Analytics Summary (200 OK - TC-DSH-01)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/analytics",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "analytics"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Analytics response contains summary, workload, and distributions', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.have.property('summary');",
              "    pm.expect(jsonData.data.summary).to.have.property('totalTasks');",
              "    pm.expect(jsonData.data.summary).to.have.property('completionRate');",
              "    pm.expect(jsonData.data.summary).to.have.property('overdueTasksCount');",
              "    pm.expect(jsonData.data.summary).to.have.property('velocity');",
              "    pm.expect(jsonData.data).to.have.property('workload');",
              "    pm.expect(jsonData.data.workload).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Export Project Tasks as CSV (200 OK - SRS FR-4.2)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/export/csv",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "export", "csv"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type header is text/csv', function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
              "});",
              "pm.test('CSV includes required headers', function () {",
              "    var csvText = pm.response.text();",
              "    pm.expect(csvText).to.include('Task ID');",
              "    pm.expect(csvText).to.include('Title');",
              "    pm.expect(csvText).to.include('Status');",
              "    pm.expect(csvText).to.include('Priority');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get Workload Aggregation (200 OK - TC-DSH-03)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/dashboard/workload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "dashboard", "workload"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array of member workload buckets', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    if (jsonData.data.length > 0) {",
              "        pm.expect(jsonData.data[0]).to.have.property('name');",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Get Overdue Tasks (200 OK - TC-DSH-04)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/dashboard/overdue",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "dashboard", "overdue"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Returns list of overdue tasks with daysOverdue', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Analytics Date Filter - Invalid Range (400 Bad Request - TC-DSH-05)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/analytics?dateFrom=2026-12-31&dateTo=2026-01-01",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "analytics"],
          "query": [
            { "key": "dateFrom", "value": "2026-12-31" },
            { "key": "dateTo", "value": "2026-01-01" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error message notes invalid date range', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.include('dateFrom cannot be later than dateTo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Send Task Reminder Email (200 OK - TC-DSH-07)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}/remind",
          "host": ["{{baseUrl}}"],
          "path": ["api", "tasks", "{{taskId}}", "remind"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 or 502 depending on external Resend API key', function () {",
              "    pm.expect([200, 502]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Get Notification Log (200 OK - TC-DSH-08)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/projects/{{projectId}}/notifications?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "projects", "{{projectId}}", "notifications"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response includes notifications list with pagination metadata', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "    pm.expect(jsonData).to.have.property('pagination');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Get My Personal Dashboard (200 OK - TC-DSH-05b)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/dashboard/me",
